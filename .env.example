# Copy this file to .env and fill in the values. Never commit .env.
# The demo runs on an Elasticsearch Serverless project (AI Indices exist only there today).

# Kibana endpoint of the Serverless project (no trailing slash).
KIBANA_URL=
# Elasticsearch endpoint of the Serverless project (no trailing slash).
ELASTICSEARCH_URL=
# API key created in that project (the encoded value).
ELASTIC_API_KEY=
# Embedding endpoint for the knowledge index. Leave as is.
INFERENCE_ID=.jina-embeddings-v5-text-small
